# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (for e-commerce features)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Optional: Custom domain
VITE_CUSTOM_DOMAIN=your-domain.com

# ---------------------------------------------------------------------------
# Optional: local admin bypass (username `admin` / password `admin`)
#
# OFF by default in production builds; always ON in the Vite dev server.
# Set to `true` only for demos/staging. This is a client-side gate, NOT access
# control - it ships in the public JS bundle. Never enable it on a deployment
# that holds real business data.
# VITE_ENABLE_LOCAL_ADMIN=true

# ---------------------------------------------------------------------------
# Optional: Google Analytics
#
# Analytics is opt-in. Leave unset (or a placeholder) and NO gtag request is
# made. Must look like G-XXXXXXX, GT-XXXXXXX, UA-XXXXXXX-X or AW-XXXXXXX.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# NEVER put these in this file - it is committed to git:
#   sbp_...            Supabase personal access token (account-wide, MCP/CLI)
#   sb_secret_...      Supabase secret key (bypasses Row Level Security)
#   service_role JWT   legacy equivalent of the above
# src/lib/supabase.ts now detects and refuses all three in client env.
