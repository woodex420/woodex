# Hostinger & Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API Configuration
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-here

# Third-party Integrations
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@woodex.com
SENDGRID_FROM_NAME=WOODEX

WHATSAPP_BUSINESS_ACCOUNT_ID=your-wa-business-id
WHATSAPP_PHONE_NUMBER_ID=your-wa-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-wa-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Frontend URLs
VITE_API_BASE_URL=http://localhost:3001
VITE_FRONTEND_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# Database Configuration (Optional - if using Hostinger PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Hostinger Hosting Details
HOSTINGER_FTP_HOST=your-hostinger-ftp.hostinger.com
HOSTINGER_FTP_USER=your-ftp-username
HOSTINGER_FTP_PASSWORD=your-ftp-password
